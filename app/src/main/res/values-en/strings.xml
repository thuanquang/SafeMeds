    <!-- FAQ Questions -->
    <string name="support_faq_1_q">How to scan a medicine barcode?</string>
    <string name="support_faq_1_a">On the home screen, tap the "Scan" button in the bottom navigation. Point your camera at the barcode on the medicine box and hold steady for a few seconds for the app to recognize it.</string>
    <string name="support_faq_2_q">Is the medicine information accurate?</string>
    <string name="support_faq_2_a">Medicine information in SafeMed is sourced from reliable sources like the Vietnam Drug Administration. However, you should consult a doctor or pharmacist before using any medication.</string>
    <string name="support_faq_3_q">How to find a pharmacy near me?</string>
    <string name="support_faq_3_a">Tap the "Pharmacy" tab in the navigation. The app will use your location to display the nearest pharmacies. You need to allow the app to access your location.</string>
    <string name="support_faq_4_q">Can I view my scan history?</string>
    <string name="support_faq_4_a">Yes. Go to "Profile"> "Scan History" to see the list of medicines you have scanned before.</string>
    <string name="support_faq_5_q">How to change password?</string>
    <string name="support_faq_5_a">Go to "Profile"> "Change Password". Enter your current password and new password, then tap "Save Changes".</string>
    <string name="support_faq_6_q">Is the app free?</string>
    <string name="support_faq_6_a">SafeMed is completely free with basic features. Some advanced features may require a Premium subscription in the future.</string>
    <string name="support_faq_7_q">How to delete my account?</string>
    <string name="support_faq_7_a">Go to "Profile"> "Advanced Security"> "Delete Account". Note: This action cannot be undone.</string>
